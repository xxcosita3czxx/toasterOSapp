#!/bin/sh

# Simple ToasterOS startup script for Alpine Linux
# Add this to /etc/local.d/toasteros.start

# Change this to your actual ToasterOSapp directory
TOASTEROS_DIR="/home/user/ToasterOSapp"

# Wait for system to be ready
sleep 5

# Start ToasterOS in background
cd "$TOASTEROS_DIR"
nohup python3 startx-toasteros.py python main.py > /var/log/toasteros.log 2>&1 &

echo "ToasterOS started"
