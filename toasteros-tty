#!/sbin/openrc-run

name="ToasterOS"
description="ToasterOS replaces the TTY1 login prompt after startup"

# This service runs on TTY1 during system startup, replacing the default TTY login.
# To access a shell, use Ctrl+Alt+F2 (or F3, F4, etc.)
# To return to ToasterOS, use Ctrl+Alt+F1

# Command configuration
command="/usr/bin/python3"
command_args="main.py"

respawn_delay=5

# Dependencies - run after user services
depend() {
    need localmount bootmisc
    # after users
    keyword -prefix -lxc
}

start_pre() {
    # Set up environment
    export DISPLAY=:1
    export XDG_RUNTIME_DIR="/tmp/runtime-toasteros"
    export SDL_VIDEODRIVER=kmsdrm
    
    # Create runtime directory
    checkpath --directory --mode 0755 "${XDG_RUNTIME_DIR}"
    cd /root/toasterOSapp
    einfo "Starting ${name}..."
}

start() {
    ebegin "Starting ${name}"
    cd /root/toasterOSapp
    # Run in background so boot can continue
    start-stop-daemon --start \
        --background \
        --make-pidfile \
        --pidfile /var/run/toasteros.pid \
        --exec "${command}" \
        --stdout /var/log/toasteros.log \
        --stderr /var/log/toasteros.log \
        --chdir "/root/toasterOSapp" \
        -- ${command_args}
    
    eend $?
}

stop() {
    ebegin "Stopping ${name}"
    
    # Use start-stop-daemon to stop the process
    start-stop-daemon --stop \
        --pidfile /var/run/toasteros.pid \
        --retry 15
    
    # Clean up any remaining processes
    pkill -f "X.*:1" 2>/dev/null || true
    pkill -f "startx-toasteros.py" 2>/dev/null || true
    pkill -f "ToasterOSapp.*main.py" 2>/dev/null || true
    
    # Remove PID file
    rm -f /var/run/toasteros.pid
    
    eend $?
}

restart() {
    stop
    sleep ${respawn_delay}
    start
}
